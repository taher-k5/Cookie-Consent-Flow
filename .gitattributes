# Kept out of the Composer dist package (and `git archive`): development
# tooling and internal notes, not needed to run the plugin. tests/ includes
# fixtures and scripts meant only for disposable test installs.
/tests            export-ignore
/phpunit.xml      export-ignore
/CLAUDE.md        export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore

# Consistent line endings for text files.
* text=auto eol=lf
*.svg text eol=lf
