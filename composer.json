{
    "name": "sfs-infotech/craft-cookie-consent-flow",
    "description": "Cookie consent and compliance management for Craft CMS 5 \u2014 banners, categories, geo-targeting, consent logs, and multi-site support.",
    "type": "craft-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "craft",
        "craftcms",
        "cookie",
        "consent",
        "gdpr",
        "ccpa",
        "cookie-banner",
        "compliance"
    ],
    "support": {
        "email": "hello@softwareforsolution.com",
        "issues": "https://github.com/sfsinfotech/cookie-consent-flow/issues?state=open",
        "source": "https://github.com/sfsinfotech/cookie-consent-flow",
        "docs": "https://github.com/sfsinfotech/cookie-consent-flow",
        "rss": "https://github.com/sfsinfotech/cookie-consent-flow/releases.atom"
    },
    "require": {
        "php": ">=8.2.0",
        "craftcms/cms": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "sfsinfotech\\craftcookieconsentflow\\": "src/"
        }
    },
    "extra": {
        "handle": "cookie-consent-flow",
        "name": "Cookie Consent Flow",
        "developer": "SFS Infotech",
        "developerUrl": "https://softwareforsolution.com",
        "documentationUrl": "https://github.com/sfsinfotech/cookie-consent-flow",
        "changelogUrl": "https://raw.githubusercontent.com/sfsinfotech/cookie-consent-flow/main/CHANGELOG.md"
    },
    "scripts": {
        "test": "phpunit",
        "test-js": "node tests/js/runtime.test.js",
        "check-all": [
            "@test",
            "@test-js"
        ]
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "sfsinfotech\\craftcookieconsentflow\\tests\\": "tests/"
        }
    }
}
