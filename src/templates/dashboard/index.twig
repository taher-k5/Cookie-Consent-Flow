{% extends "_layouts/cp" %}

{% set title = "Cookie Consent Flow"|t('cookie-consent-flow') %}

{% block content %}
<div class="cck-dashboard">
    <div class="readable">

        {# Stats #}
        <div class="cck-stat-grid">
            <div class="cck-stat">
                <div class="cck-stat__number">{{ stats.total }}</div>
                <div class="cck-stat__label">{{ "Total Consents"|t('cookie-consent-flow') }}</div>
            </div>
            <div class="cck-stat">
                <div class="cck-stat__number">{{ stats.acceptAll }}</div>
                <div class="cck-stat__label">{{ "Accepted All"|t('cookie-consent-flow') }}</div>
            </div>
            <div class="cck-stat">
                <div class="cck-stat__number">{{ stats.rejectAll }}</div>
                <div class="cck-stat__label">{{ "Rejected All"|t('cookie-consent-flow') }}</div>
            </div>
            <div class="cck-stat">
                <div class="cck-stat__number">{{ stats.custom }}</div>
                <div class="cck-stat__label">{{ "Custom Choices"|t('cookie-consent-flow') }}</div>
            </div>
        </div>

        <p>
            <a href="{{ cpUrl('cookie-consent-flow/banner') }}" class="btn">
                {{ "Edit Banner"|t('cookie-consent-flow') }}
            </a>
        </p>

        <p>
            <a href="{{ cpUrl('cookie-consent-flow/settings') }}" class="btn">
                {{ "Edit Settings"|t('cookie-consent-flow') }}
            </a>
        </p>

    </div>
</div>
{% endblock %}

