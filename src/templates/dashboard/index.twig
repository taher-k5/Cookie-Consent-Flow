{% extends "_layouts/cp" %}

{% set title = "Cookie Consent Flow"|t('cookie-consent-flow') %}

{% block content %}
<div class="cck-dashboard">
    <div class="readable">

        {# ── Consent at a glance ────────────────────────────────────────── #}
        {% if canViewLogs %}
            <h2>{{ "Consent Overview"|t('cookie-consent-flow') }}</h2>

            {% if overview.total == 0 %}
                <p class="light">
                    {{ "No consent has been recorded for this site yet. Figures appear here once visitors start responding to the banner."|t('cookie-consent-flow') }}
                </p>
            {% else %}
                <div class="ccf-stats-grid">
                    {% set outcomeCards = [
                        { label: "Accepted all"|t('cookie-consent-flow'),  count: overview.acceptAll },
                        { label: "Rejected all"|t('cookie-consent-flow'),  count: overview.rejectAll },
                        { label: "Partial consent"|t('cookie-consent-flow'), count: overview.custom },
                        { label: "Total decisions"|t('cookie-consent-flow'), count: overview.total },
                    ] %}

                    {% for card in outcomeCards %}
                        <div class="ccf-stat-card">
                            <div class="ccf-stat-title">{{ card.label }}</div>
                            <div class="ccf-stat-main">{{ card.count }}</div>
                            <div class="ccf-stat-meta">
                                {%- if card.label == "Total decisions"|t('cookie-consent-flow') -%}
                                    {{ "All recorded decisions"|t('cookie-consent-flow') }}
                                {%- else -%}
                                    {{ ((card.count / overview.total) * 100)|round }}% {{ "of decisions"|t('cookie-consent-flow') }}
                                {%- endif -%}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {% if overview.categories is not empty %}
                    <h3>{{ "Acceptance by category"|t('cookie-consent-flow') }}</h3>
                    <table class="data fullwidth cck-category-stats">
                        <thead>
                            <tr>
                                <th scope="col">{{ "Category"|t('cookie-consent-flow') }}</th>
                                <th scope="col">{{ "Accepted"|t('cookie-consent-flow') }}</th>
                                <th scope="col">{{ "Rate"|t('cookie-consent-flow') }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for key, stat in overview.categories %}
                                <tr>
                                    <th scope="row">{{ stat.label }}</th>
                                    <td>{{ stat.count }}</td>
                                    <td>
                                        {# A meter, not a bare bar: it carries its
                                           own accessible value, so the figure is
                                           available without reading the pixels. #}
                                        <meter min="0" max="100" value="{{ stat.percent }}"
                                               title="{{ stat.percent }}%">{{ stat.percent }}%</meter>
                                        <span>{{ stat.percent }}%</span>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}

                <p>
                    <a href="{{ cpUrl('cookie-consent-flow/logs', { site: currentSite.handle }) }}" class="btn">
                        {{ "View consent records"|t('cookie-consent-flow') }}
                    </a>
                </p>
            {% endif %}

            <hr>
        {% endif %}

        <h2>{{ "Live Banner Preview"|t('cookie-consent-flow') }}</h2>
        <p class="light">
            {{ "This is how your cookie banner currently looks to visitors, using your saved Banner settings."|t('cookie-consent-flow') }}
        </p>

        {% if allSites|length > 1 %}
            <div class="field cck-preview-site-switcher">
                <label for="cck-preview-site">{{ "Previewing site"|t('cookie-consent-flow') }}</label>
                <div class="select">
                    <select id="cck-preview-site" onchange="location.href=this.value">
                        {% for site in allSites %}
                            <option
                                value="{{ cpUrl('cookie-consent-flow', { site: site.handle }) }}"
                                {% if site.id == currentSite.id %}selected{% endif %}
                            >{{ site.name }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        {% endif %}

        {# ── Device size switcher (outside the preview frame) ── #}
        <div class="cck-preview-devices" role="group" aria-label="{{ 'Preview device size'|t('cookie-consent-flow') }}">
            <button type="button" class="cck-preview-device-btn sel" data-device="desktop">{{ "Desktop"|t('cookie-consent-flow') }}</button>
            <button type="button" class="cck-preview-device-btn" data-device="tablet">{{ "Tablet"|t('cookie-consent-flow') }}</button>
            <button type="button" class="cck-preview-device-btn" data-device="mobile">{{ "Mobile"|t('cookie-consent-flow') }}</button>
        </div>

        {# ── Site skeleton + real banner rendered on top, as a preview ── #}
        <div class="cck-preview-frame">
            <span class="cck-preview-badge">{{ "Live Preview"|t('cookie-consent-flow') }}</span>

            <div class="cck-preview-chrome">
                <span class="cck-preview-dot"></span>
                <span class="cck-preview-dot"></span>
                <span class="cck-preview-dot"></span>
                <span class="cck-preview-url">yoursite.com</span>
            </div>

            <div class="cck-preview-body">
                {# Fake nav #}
                <div class="cck-skeleton-nav">
                    <span class="cck-skeleton cck-skeleton--logo"></span>
                    <span class="cck-skeleton cck-skeleton--pill cck-skeleton--pill-first"></span>
                    <span class="cck-skeleton cck-skeleton--pill"></span>
                    <span class="cck-skeleton cck-skeleton--pill"></span>
                </div>

                {# Fake hero #}
                <div class="cck-skeleton-hero">
                    <span class="cck-skeleton cck-skeleton--line cck-skeleton--w60"></span>
                    <span class="cck-skeleton cck-skeleton--line cck-skeleton--w40"></span>
                    <span class="cck-skeleton cck-skeleton--btn"></span>
                </div>

                {# Fake content cards #}
                <div class="cck-skeleton-grid">
                    <span class="cck-skeleton cck-skeleton--card"></span>
                    <span class="cck-skeleton cck-skeleton--card"></span>
                    <span class="cck-skeleton cck-skeleton--card"></span>
                </div>

                {# The real banner, rendered with the admin's actual saved settings.
                   `isPreview` keeps it from announcing itself as a modal dialog
                   inside a control-panel page the admin is still using. #}
                {% include 'cookie-consent-flow/banner/_banner' with { settings: settings, isPreview: true } %}
            </div>
        </div>

        <p>
            <a href="{{ cpUrl('cookie-consent-flow/banner') }}" class="btn submit">
                {{ "Edit Banner"|t('cookie-consent-flow') }}
            </a>
            <a href="{{ cpUrl('cookie-consent-flow/settings') }}" class="btn">
                {{ "Edit Settings"|t('cookie-consent-flow') }}
            </a>
            {% if canViewLogs %}
                <a href="{{ cpUrl('cookie-consent-flow/logs') }}" class="btn">
                    {{ "View Consent Records"|t('cookie-consent-flow') }}
                </a>
            {% endif %}
        </p>

    </div>
</div>
{% endblock %}
