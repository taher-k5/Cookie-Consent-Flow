{% extends "_layouts/cp" %}

{% set title = "Consent Logs"|t('cookie-consent-flow') %}
{% set selectedSubnavItem = 'logs' %}

{% import _self as self %}

{% block content %}

{# Build each link's query params by merging onto whichever of site/filter
   isn't being changed by that particular control, so switching one filter
   never resets the other. "All Sites" is carried explicitly as `site=all`
   (not simply omitted) so the choice is unambiguous, always produces a
   real URL change when picked, and round-trips through bookmarks/reloads
   the same way an actual site selection does. #}
{% set siteParams = { site: currentSite ? currentSite.handle : 'all' } %}
{% set filterParams = filter ? { filter: filter } : {} %}

<div class="ccf-log-filters flex" style="gap:12px;align-items:flex-end;margin-bottom:16px;">
    {% if allSites|length > 1 %}
        <div class="field">
            <label for="ccf-filter-site">{{ "Site"|t('cookie-consent-flow') }}</label>
            <div class="select">
                <select id="ccf-filter-site" onchange="location.href=this.value">
                    <option
                        value="{{ cpUrl('cookie-consent-flow/logs', filterParams|merge({ site: 'all' })) }}"
                        {% if currentSite is null %}selected{% endif %}
                    >{{ "All Sites"|t('cookie-consent-flow') }}</option>
                    {% for site in allSites %}
                        <option
                            value="{{ cpUrl('cookie-consent-flow/logs', filterParams|merge({ site: site.handle })) }}"
                            {% if currentSite and site.id == currentSite.id %}selected{% endif %}
                        >{{ site.name }}</option>
                    {% endfor %}
                </select>
            </div>
        </div>
    {% endif %}

    <div class="field">
        <label for="ccf-filter-action">{{ "Action"|t('cookie-consent-flow') }}</label>
        <div class="select">
            <select id="ccf-filter-action" onchange="location.href=this.value">
                <option value="{{ cpUrl('cookie-consent-flow/logs', siteParams) }}" {% if filter == '' %}selected{% endif %}>{{ "All"|t('cookie-consent-flow') }}</option>
                <option value="{{ cpUrl('cookie-consent-flow/logs', siteParams|merge({ filter: 'accept_all' })) }}" {% if filter == 'accept_all' %}selected{% endif %}>{{ "Accept All"|t('cookie-consent-flow') }}</option>
                <option value="{{ cpUrl('cookie-consent-flow/logs', siteParams|merge({ filter: 'reject_all' })) }}" {% if filter == 'reject_all' %}selected{% endif %}>{{ "Reject All"|t('cookie-consent-flow') }}</option>
                <option value="{{ cpUrl('cookie-consent-flow/logs', siteParams|merge({ filter: 'custom' })) }}" {% if filter == 'custom' %}selected{% endif %}>{{ "Custom"|t('cookie-consent-flow') }}</option>
            </select>
        </div>
    </div>
</div>

{# Visible confirmation of the current scope — the closed <select> already
   shows the right label, but a persistent line here means the active
   site/action filter is legible without having to open either dropdown. #}
{% set filterLabels = {
    'accept_all': "Accept All"|t('cookie-consent-flow'),
    'reject_all': "Reject All"|t('cookie-consent-flow'),
    'custom':     "Custom"|t('cookie-consent-flow'),
} %}
<p class="light" style="margin:-4px 0 16px;">
    {{ "Showing"|t('cookie-consent-flow') }}:
    {% if allSites|length > 1 %}
        <strong>{{ currentSite ? currentSite.name : "All Sites"|t('cookie-consent-flow') }}</strong>
        &middot;
    {% endif %}
    <strong>{{ filterLabels[filter] ?? "All actions"|t('cookie-consent-flow') }}</strong>
</p>

<div class="ccf-stats-grid">
    {% for card in statsCards %}
        <div class="ccf-stat-card">
            <div class="ccf-stat-title">
                {{ card.label }}
            </div>

            <div class="ccf-stat-main">
                {{ card.count }}
            </div>

            {% if card.label != 'Total Records' %}
                <div class="ccf-stat-meta">
                    {{ card.percent }}% of total consents
                </div>
            {% else %}
                <div class="ccf-stat-meta">
                    Total consent submissions
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>

{# ── Empty state ─────────────────────────────────────────────────────── #}
{% if records is empty %}
    <div class="zilch">
        <p>{{ "No consent records found."|t('cookie-consent-flow') }}</p>
    </div>

{% else %}

{# ── Records table ───────────────────────────────────────────────────── #}
<div class="tableview tablepane ccf-table-wrapper">
    <table class="data ccf-log-table">
        <thead>
            <tr>
                {% if allSites|length > 1 %}
                    <th>{{ "Site"|t('cookie-consent-flow') }}</th>
                {% endif %}
                <th>{{ "Visitor UUID"|t('cookie-consent-flow') }}</th>
                <th>{{ "Action"|t('cookie-consent-flow') }}</th>
                <th>{{ "Categories"|t('cookie-consent-flow') }}</th>
                <th>{{ "Country"|t('cookie-consent-flow') }}</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}

                {% set recordSite = craft.app.sites.getSiteById(record.siteId) %}
                {% set cats = record.categories|json_decode %}
                {% set catLabels = [] %}

                {% for cat in cats %}
                    {% set catLabels = catLabels|merge([cat|capitalize]) %}
                {% endfor %}

                {% if record.action == 'accept_all' %}
                    {% set badgeClass = 'green' %}
                    {% set actionLabel = 'Accept All' %}
                {% elseif record.action == 'reject_all' %}
                    {% set badgeClass = 'red' %}
                    {% set actionLabel = 'Reject All' %}
                {% else %}
                    {% set badgeClass = 'blue' %}
                    {% set actionLabel = 'Custom' %}
                {% endif %}

                <tr>
                    {% if allSites|length > 1 %}
                        <td>
                            {{ recordSite ? recordSite.name : "Deleted Site (ID: {id})"|t('cookie-consent-flow', { id: record.siteId }) }}
                        </td>
                    {% endif %}
                    <td>
                        {{ record.visitorUuid }}
                    </td>

                    <td>
                        <span class="ccf-action-badge ccf-{{ badgeClass }}">
                            {{ actionLabel }}
                        </span>
                    </td>

                    <td>
                        <div class="ccf-category-pills">
                            {% for label in catLabels %}
                                <span class="ccf-category-pill-table">
                                    {{ label }}
                                </span>
                            {% endfor %}
                        </div>
                    </td>

                    <td>
                        {{ record.countryCode ?: '—' }}
                    </td>

                    <td>
                        <a href="{{ cpUrl('cookie-consent-flow/logs/view/' ~ record.id) }}" class="btn small">
                            View
                        </a>
                    </td>
                </tr>

            {% endfor %}
        </tbody>
    </table>
</div>

{# ── Pagination ──────────────────────────────────────────────────────── #}
{% if totalPages > 1 %}
<nav class="flex center" style="margin-top:24px;gap:8px;">
    {% if page > 1 %}
        <a href="{{ cpUrl('cookie-consent-flow/logs', siteParams|merge(filterParams)|merge({ page: page - 1 })) }}"
           class="btn">← {{ "Previous"|t('app') }}</a>
    {% endif %}

    <span class="light">
        {{ "Page {current} of {total}"|t('cookie-consent-flow', {
            current: page,
            total:   totalPages
        }) }}
    </span>

    {% if page < totalPages %}
        <a href="{{ cpUrl('cookie-consent-flow/logs', siteParams|merge(filterParams)|merge({ page: page + 1 })) }}"
           class="btn">{{ "Next"|t('app') }} →</a>
    {% endif %}
</nav>
{% endif %}

{% endif %}{# /empty check #}

{% endblock %}
