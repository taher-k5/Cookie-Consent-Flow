{% extends "_layouts/cp" %}

{% set title = "Consent Record"|t('cookie-consent-flow') %}
{% set selectedSubnavItem = 'logs' %}

{% block content %}

{% set categories = record.categories|json_decode %}
{% set recordSite = craft.app.sites.getSiteById(record.siteId) %}

<div class="ccf-detail-card">

    <h2>Additional Information</h2>

    <table class="data fullwidth">

        <tbody>

        <tr>
            <th>ID</th>
            <td>{{ record.id }}</td>
        </tr>

        <tr>
            <th>Visitor UUID</th>
            <td>{{ record.visitorUuid }}</td>
        </tr>

        <tr>
            <th>{{ "Source"|t('cookie-consent-flow') }}</th>
            <td>
                {{ {
                    'banner': "Banner"|t('cookie-consent-flow'),
                    'gpc':    "Global Privacy Control"|t('cookie-consent-flow'),
                    'dnt':    "Do Not Track"|t('cookie-consent-flow'),
                    'api':    "JavaScript API"|t('cookie-consent-flow'),
                }[record.source] ?? record.source ?? '—' }}
            </td>
        </tr>

        <tr>
            <th>{{ "Policy version"|t('cookie-consent-flow') }}</th>
            <td>{{ record.policyVersion ?: '—' }}</td>
        </tr>

        <tr>
            <th>{{ "IP Hash"|t('cookie-consent-flow') }}</th>
            <td>
                <code>{{ record.ipHash }}</code>
                {# Worth stating plainly, because the field name invites the
                   opposite assumption: the salt is random per record, so this
                   hash cannot be reversed to an IP and cannot be compared
                   against another record's. It is deliberately not a way to
                   group or identify a visitor. #}
                <p class="light">
                    {{ "Salted per record — cannot be reversed to an IP address, and cannot be matched against other records."|t('cookie-consent-flow') }}
                </p>
            </td>
        </tr>

        <tr>
            <th>Country</th>
            <td>{{ record.countryCode ?: '—' }}</td>
        </tr>

        <tr>
            <th>Site</th>
            <td>{{ recordSite ? recordSite.name : "Deleted Site (ID: {id})"|t('cookie-consent-flow', { id: record.siteId }) }}</td>
        </tr>

        <tr>
            <th>User Agent</th>
            <td>{{ record.userAgent }}</td>
        </tr>

        <tr>
            <th>Created</th>
            <td>{{ record.dateCreated|date('Y-m-d H:i:s') }}</td>
        </tr>

        </tbody>

    </table>

</div>

<div class="ccf-detail-card">

    <h2>Accepted Categories</h2>

    <div class="ccf-category-list">

        {% for category in categories %}
            <span class="ccf-category-pill">
                {{ category|capitalize }}
            </span>
        {% endfor %}

    </div>

</div>

<div style="margin-top:20px;">
    <a class="btn" href="{{ cpUrl('cookie-consent-flow/logs') }}">
        Back to Logs
    </a>
</div>

{% endblock %}