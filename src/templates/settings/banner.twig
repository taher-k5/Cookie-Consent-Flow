{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Banner Settings"|t('cookie-consent-kit') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'banner' %}

{% block actionButton %}
    <div class="btngroup">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
<input type="hidden" name="action" value="cookie-consent-kit/settings/save-banner">
{{ redirectInput('cookie-consent-kit/banner') }}
{{ csrfInput() }}

<div id="cck-banner-settings">

{# ── 1. General ────────────────────────────────────────────────────────── #}
<h2>{{ "General"|t('cookie-consent-kit') }}</h2>

{{ forms.lightswitchField({
    label:        "Enable Cookie Banner"|t('cookie-consent-kit'),
    instructions: "Display the consent banner to all site visitors."|t('cookie-consent-kit'),
    id:           'bannerEnabled',
    name:         'settings[bannerEnabled]',
    on:           settings.bannerEnabled,
}) }}

{{ forms.selectField({
    label:        "Banner Layout"|t('cookie-consent-kit'),
    instructions: "Choose how and where the banner appears on the page."|t('cookie-consent-kit'),
    id:           'bannerLayout',
    name:         'settings[bannerLayout]',
    value:        settings.bannerLayout,
    options: [
        { value: 'bottom-bar',   label: "Bottom Bar"|t('cookie-consent-kit') },
        { value: 'top-bar',      label: "Top Bar"|t('cookie-consent-kit') },
        { value: 'center-popup', label: "Center Popup"|t('cookie-consent-kit') },
        { value: 'corner-popup', label: "Corner Popup"|t('cookie-consent-kit') },
    ],
}) }}

<div id="cck-corner-position-field"{% if settings.bannerLayout != 'corner-popup' %} class="hidden"{% endif %}>
    {{ forms.selectField({
        label:   "Corner Position"|t('cookie-consent-kit'),
        id:      'cornerPosition',
        name:    'settings[cornerPosition]',
        value:   settings.cornerPosition,
        options: [
            { value: 'bottom-right', label: "Bottom Right"|t('cookie-consent-kit') },
            { value: 'bottom-left',  label: "Bottom Left"|t('cookie-consent-kit') },
        ],
    }) }}
</div>

{{ forms.lightswitchField({
    label:        "Fixed / Sticky Position"|t('cookie-consent-kit'),
    instructions: "Keep the banner fixed on screen while the user scrolls."|t('cookie-consent-kit'),
    id:           'fixedPosition',
    name:         'settings[fixedPosition]',
    on:           settings.fixedPosition,
}) }}

{{ forms.lightswitchField({
    label:        "Full Width"|t('cookie-consent-kit'),
    instructions: "Stretch the banner to the full viewport width."|t('cookie-consent-kit'),
    id:           'fullWidth',
    name:         'settings[fullWidth]',
    on:           settings.fullWidth,
}) }}

{{ forms.lightswitchField({
    label:        "Shadow"|t('cookie-consent-kit'),
    instructions: "Show a drop shadow around the banner."|t('cookie-consent-kit'),
    id:           'shadow',
    name:         'settings[shadow]',
    on:           settings.shadow,
}) }}

<hr>

{# ── 2. Content ────────────────────────────────────────────────────────── #}
<h2>{{ "Content"|t('cookie-consent-kit') }}</h2>

{{ forms.textField({
    label:        "Heading"|t('cookie-consent-kit'),
    instructions: "Main heading shown at the top of the banner."|t('cookie-consent-kit'),
    id:           'bannerHeading',
    name:         'settings[bannerHeading]',
    value:        settings.bannerHeading,
    placeholder:  "We value your privacy",
}) }}

{{ forms.textareaField({
    label:        "Description"|t('cookie-consent-kit'),
    instructions: "Explain how your site uses cookies. Basic HTML (links, strong) is allowed."|t('cookie-consent-kit'),
    id:           'bannerDescription',
    name:         'settings[bannerDescription]',
    value:        settings.bannerDescription,
    rows:          4,
}) }}

{{ forms.textField({
    label:       "Privacy Policy URL"|t('cookie-consent-kit'),
    id:          'privacyPolicyUrl',
    name:        'settings[privacyPolicyUrl]',
    value:       settings.privacyPolicyUrl,
    type:        'url',
    placeholder: 'https://example.com/privacy',
}) }}

{{ forms.textField({
    label: "Privacy Policy Link Label"|t('cookie-consent-kit'),
    id:    'privacyPolicyLinkText',
    name:  'settings[privacyPolicyLinkText]',
    value: settings.privacyPolicyLinkText,
}) }}

<hr>

{# ── 3. Button Labels ──────────────────────────────────────────────────── #}

<h2>{{ "Banner Colours"|t('cookie-consent-kit') }}</h2>

<div class="flex flex-wrap gap-4 mb-4">
    {{ forms.colorField({
        label: "Banner Background"|t('cookie-consent-kit'),
        id: 'bannerBgColor',
        name: 'settings[bannerBgColor]',
        value: settings.bannerBgColor
    }) }}

    {{ forms.colorField({
        label: "Banner Border"|t('cookie-consent-kit'),
        id: 'bannerBorderColor',
        name: 'settings[bannerBorderColor]',
        value: settings.bannerBorderColor
    }) }}

    {{ forms.textField({
        label: "Overlay (popups)"|t('cookie-consent-kit'),
        id: 'overlayColor',
        name: 'settings[overlayColor]',
        value: settings.overlayColor
    }) }}
</div>

<h3>{{ "Text"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.colorField({
        label: "Heading"|t('cookie-consent-kit'),
        id: 'headingColor',
        name: 'settings[headingColor]',
        value: settings.headingColor
    }) }}

    {{ forms.colorField({
        label: "Description"|t('cookie-consent-kit'),
        id: 'descriptionColor',
        name: 'settings[descriptionColor]',
        value: settings.descriptionColor
    }) }}

    {{ forms.colorField({
        label: "Links"|t('cookie-consent-kit'),
        id: 'linkColor',
        name: 'settings[linkColor]',
        value: settings.linkColor
    }) }}

</div>

<h3>{{ "Accept Button"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.colorField({
        label: "Background"|t('cookie-consent-kit'),
        id: 'acceptBgColor',
        name: 'settings[acceptBgColor]',
        value: settings.acceptBgColor
    }) }}

    {{ forms.colorField({
        label: "Text"|t('cookie-consent-kit'),
        id: 'acceptTextColor',
        name: 'settings[acceptTextColor]',
        value: settings.acceptTextColor
    }) }}

    {{ forms.colorField({
        label: "Border"|t('cookie-consent-kit'),
        id: 'acceptBorderColor',
        name: 'settings[acceptBorderColor]',
        value: settings.acceptBorderColor
    }) }}

    {{ forms.colorField({
        label: "Hover Background"|t('cookie-consent-kit'),
        id: 'acceptHoverBgColor',
        name: 'settings[acceptHoverBgColor]',
        value: settings.acceptHoverBgColor
    }) }}

    {{ forms.colorField({
        label: "Hover Text"|t('cookie-consent-kit'),
        id: 'acceptHoverTextColor',
        name: 'settings[acceptHoverTextColor]',
        value: settings.acceptHoverTextColor
    }) }}

</div>

<h3>{{ "Reject Button"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.colorField({
        label: "Background"|t('cookie-consent-kit'),
        id: 'rejectBgColor',
        name: 'settings[rejectBgColor]',
        value: settings.rejectBgColor
    }) }}

    {{ forms.colorField({
        label: "Text"|t('cookie-consent-kit'),
        id: 'rejectTextColor',
        name: 'settings[rejectTextColor]',
        value: settings.rejectTextColor
    }) }}

    {{ forms.colorField({
        label: "Border"|t('cookie-consent-kit'),
        id: 'rejectBorderColor',
        name: 'settings[rejectBorderColor]',
        value: settings.rejectBorderColor
    }) }}

    {{ forms.colorField({
        label: "Hover Background"|t('cookie-consent-kit'),
        id: 'rejectHoverBgColor',
        name: 'settings[rejectHoverBgColor]',
        value: settings.rejectHoverBgColor
    }) }}

    {{ forms.colorField({
        label: "Hover Text"|t('cookie-consent-kit'),
        id: 'rejectHoverTextColor',
        name: 'settings[rejectHoverTextColor]',
        value: settings.rejectHoverTextColor
    }) }}

</div>

<h3>{{ "Customize Button"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.textField({
        label: "Background"|t('cookie-consent-kit'),
        id: 'customizeBgColor',
        name: 'settings[customizeBgColor]',
        value: settings.customizeBgColor
    }) }}

    {{ forms.colorField({
        label: "Text"|t('cookie-consent-kit'),
        id: 'customizeTextColor',
        name: 'settings[customizeTextColor]',
        value: settings.customizeTextColor
    }) }}

    {{ forms.colorField({
        label: "Border"|t('cookie-consent-kit'),
        id: 'customizeBorderColor',
        name: 'settings[customizeBorderColor]',
        value: settings.customizeBorderColor
    }) }}

    {{ forms.colorField({
        label: "Hover Background"|t('cookie-consent-kit'),
        id: 'customizeHoverBgColor',
        name: 'settings[customizeHoverBgColor]',
        value: settings.customizeHoverBgColor
    }) }}

    {{ forms.colorField({
        label: "Hover Text"|t('cookie-consent-kit'),
        id: 'customizeHoverTextColor',
        name: 'settings[customizeHoverTextColor]',
        value: settings.customizeHoverTextColor
    }) }}

</div>

<h3>{{ "Save Preferences Button"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.colorField({
        label: "Background"|t('cookie-consent-kit'),
        id: 'saveBgColor',
        name: 'settings[saveBgColor]',
        value: settings.saveBgColor
    }) }}

    {{ forms.colorField({
        label: "Text"|t('cookie-consent-kit'),
        id: 'saveTextColor',
        name: 'settings[saveTextColor]',
        value: settings.saveTextColor
    }) }}

</div>

<h3>{{ "Close Icon"|t('cookie-consent-kit') }}</h3>

<div class="flex flex-wrap gap-4 mb-4">

    {{ forms.colorField({
        label: "Close Icon Colour"|t('cookie-consent-kit'),
        id: 'closeIconColor',
        name: 'settings[closeIconColor]',
        value: settings.closeIconColor
    }) }}

</div>

<hr>

{# ── 5. Layout Controls ────────────────────────────────────────────────── #}
<h2>{{ "Layout Controls"|t('cookie-consent-kit') }}</h2>

{{ forms.textField({
    label:        "Border Radius"|t('cookie-consent-kit'),
    instructions: "e.g. 8px or 0"|t('cookie-consent-kit'),
    id:    'borderRadius',
    name:  'settings[borderRadius]',
    value: settings.borderRadius,
}) }}
{{ forms.textField({
    label:        "Padding"|t('cookie-consent-kit'),
    instructions: "e.g. 24px or 16px 24px"|t('cookie-consent-kit'),
    id:    'padding',
    name:  'settings[padding]',
    value: settings.padding,
}) }}
{{ forms.textField({
    label:        "Max Width"|t('cookie-consent-kit'),
    instructions: "Ignored when Full Width is on. e.g. 600px"|t('cookie-consent-kit'),
    id:    'maxWidth',
    name:  'settings[maxWidth]',
    value: settings.maxWidth,
}) }}

<hr>

{# ── 6. Geo-targeting ──────────────────────────────────────────────────── #}
<h2>{{ "Geo-targeting"|t('cookie-consent-kit') }}</h2>

{{ forms.lightswitchField({
    label:        "Enable Geo-targeting"|t('cookie-consent-kit'),
    instructions: "Restrict banner display to specific countries only."|t('cookie-consent-kit'),
    id:   'geoEnabled',
    name: 'settings[geoEnabled]',
    on:   settings.geoEnabled,
}) }}

{{ forms.textField({
    label:        "Target Countries"|t('cookie-consent-kit'),
    instructions: "Comma-separated ISO 3166-1 alpha-2 codes, e.g. GB,DE,FR. Leave blank to show everywhere."|t('cookie-consent-kit'),
    id:    'geoTargetCountries',
    name:  'settings[geoTargetCountries]',
    value: settings.geoTargetCountries|join(', '),
}) }}

</div>{# /#cck-banner-settings #}
{% endblock %}
