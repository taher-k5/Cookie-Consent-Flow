{# Partial: a single category row in the Settings > Categories tab #}
{% import "_includes/forms" as forms %}

<div class="cck-category-row" data-index="{{ index }}">
    <div class="cck-category-row__fields">

        {{ forms.textField({
            label:       "Key"|t('cookie-consent-kit'),
            instructions:"Machine-readable identifier, e.g. analytics (lowercase, no spaces)."|t('cookie-consent-kit'),
            name:        'settings[categories][' ~ index ~ '][key]',
            value:       category.key,
            required:    true,
            class:       'code',
        }) }}

        {{ forms.textField({
            label: "Label"|t('cookie-consent-kit'),
            name:  'settings[categories][' ~ index ~ '][label]',
            value: category.label,
        }) }}

        {{ forms.textareaField({
            label: "Description"|t('cookie-consent-kit'),
            name:  'settings[categories][' ~ index ~ '][description]',
            value: category.description,
            rows:   2,
        }) }}

        <div class="cck-category-row__toggles">
            {{ forms.lightswitchField({
                label:        "Enabled by default"|t('cookie-consent-kit'),
                instructions: "Pre-check this category in the preferences panel."|t('cookie-consent-kit'),
                name:         'settings[categories][' ~ index ~ '][default]',
                on:           category.default,
            }) }}

            {{ forms.lightswitchField({
                label:        "Always on (locked)"|t('cookie-consent-kit'),
                instructions: "Visitor cannot disable this category."|t('cookie-consent-kit'),
                name:         'settings[categories][' ~ index ~ '][locked]',
                on:           category.locked,
            }) }}
        </div>
    </div>

    <button
        type="button"
        class="btn small delete icon cck-remove-category"
        title="{{ 'Remove category'|t('cookie-consent-kit') }}"
        aria-label="{{ 'Remove category'|t('cookie-consent-kit') }}"
        {% if category.locked %}disabled{% endif %}
    >{{ "Remove"|t('cookie-consent-kit') }}</button>

    <hr>
</div>
