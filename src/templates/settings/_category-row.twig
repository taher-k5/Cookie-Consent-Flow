{# Partial: a single category row in the Settings > Categories tab #}
{% import "_includes/forms" as forms %}
{% set namePrefix = namePrefix ?? 'settings' %}

{# Every Google Consent Mode v2 signal. Listed here rather than derived from a
   category key, because the mapping is entirely the admin's to make: category
   keys are free-form, so nothing can be inferred from one being called
   "analytics". A category with no signals selected simply grants none. #}
{% set gcmSignalOptions = [
    { value: 'ad_storage',              label: 'ad_storage' },
    { value: 'ad_user_data',            label: 'ad_user_data' },
    { value: 'ad_personalization',      label: 'ad_personalization' },
    { value: 'analytics_storage',       label: 'analytics_storage' },
    { value: 'functionality_storage',   label: 'functionality_storage' },
    { value: 'personalization_storage', label: 'personalization_storage' },
    { value: 'security_storage',        label: 'security_storage' },
] %}

<div class="cck-category-row" data-index="{{ index }}">
    <div class="cck-category-row__fields">

        {{ forms.textField({
            label:       "Key"|t('cookie-consent-flow'),
            instructions:"Machine-readable identifier, e.g. analytics (lowercase, no spaces)."|t('cookie-consent-flow'),
            name:        namePrefix ~ '[categories][' ~ index ~ '][key]',
            value:       category.key,
            required:    true,
            class:       'code',
        }) }}

        {{ forms.textField({
            label: "Label"|t('cookie-consent-flow'),
            name:  namePrefix ~ '[categories][' ~ index ~ '][label]',
            value: category.label,
        }) }}

        {{ forms.textareaField({
            label: "Description"|t('cookie-consent-flow'),
            name:  namePrefix ~ '[categories][' ~ index ~ '][description]',
            value: category.description,
            rows:   2,
        }) }}

        <div class="cck-category-row__toggles">
            {{ forms.lightswitchField({
                label:        "Enabled by default"|t('cookie-consent-flow'),
                instructions: "Pre-check this category in the preferences panel."|t('cookie-consent-flow'),
                name:         namePrefix ~ '[categories][' ~ index ~ '][default]',
                on:           category.default,
            }) }}

            {{ forms.lightswitchField({
                label:        "Always on (locked)"|t('cookie-consent-flow'),
                instructions: "Visitor cannot disable this category."|t('cookie-consent-flow'),
                name:         namePrefix ~ '[categories][' ~ index ~ '][locked]',
                on:           category.locked,
            }) }}
        </div>

        {{ forms.multiselectField({
            label:        "Google Consent Mode signals"|t('cookie-consent-flow'),
            instructions: "Signals granted when a visitor accepts this category. Only used when Consent Mode is enabled; leave empty to grant none."|t('cookie-consent-flow'),
            name:         namePrefix ~ '[categories][' ~ index ~ '][gcmSignals]',
            options:      gcmSignalOptions,
            values:       category.gcmSignals ?? [],
            class:        'cck-gcm-signals',
        }) }}
    </div>

    <button
        type="button"
        class="btn small delete icon cck-remove-category"
        title="{{ 'Remove category'|t('cookie-consent-flow') }}"
        aria-label="{{ 'Remove category'|t('cookie-consent-flow') }}"
        {% if category.locked %}disabled{% endif %}
    >{{ "Remove"|t('cookie-consent-flow') }}</button>
</div>
