{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Cookie Consent Flow Settings"|t('cookie-consent-flow') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'settings' %}
{% set tabs = {
    'cck-categories': {
        label: "Cookie Categories"|t('cookie-consent-flow'),
        url: '#cck-categories',
    },
    'cck-logging': {
        label: "Consent Logging"|t('cookie-consent-flow'),
        url: '#cck-logging',
    },
    'cck-integrations': {
        label: "Integrations"|t('cookie-consent-flow'),
        url: '#cck-integrations',
    },
    'cck-privacy-signals': {
        label: "Privacy Signals"|t('cookie-consent-flow'),
        url: '#cck-privacy-signals',
    },
    'cck-advanced': {
        label: "Advanced"|t('cookie-consent-flow'),
        url: '#cck-advanced',
    },
} %}
{% block actionButton %}
    <div class="btngroup">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
<input type="hidden" name="action" value="cookie-consent-flow/settings/save">
{{ redirectInput('cookie-consent-flow/settings') }}
{{ csrfInput() }}

<div id="cck-settings">

{# ── Categories ────────────────────────────────────────────────────────── #}
<div id="cck-categories" role="tabpanel" aria-labelledby="tab-cck-categories">
    <div class="cck-page-intro">
        <p>{{ "Configure the cookie categories visitors can toggle in the preferences panel."|t('cookie-consent-flow') }}</p>
    </div>

    <div class="cck-categories-group">
        <div id="cck-categories-list" class="cck-categories-list">
            {% for i, category in settings.categories %}
                {% include 'cookie-consent-flow/settings/_category-row' with {
                    category: category,
                    index:    i,
                } %}
            {% endfor %}
        </div>

        <button type="button" id="cck-add-category" class="btn add icon cck-add-category cck-add-row--block">
            {{ "Add Category"|t('cookie-consent-flow') }}
        </button>

        <template id="cck-category-template" class="cck-category-template">
            {% include 'cookie-consent-flow/settings/_category-row' with {
                category: { key: '', label: '', description: '', default: false, locked: false },
                index:    '__INDEX__',
            } %}
        </template>
    </div>
</div>{# /tab-categories #}

{# ── Consent Logging ───────────────────────────────────────────────────── #}
<div id="cck-logging" class="hidden" role="tabpanel" aria-labelledby="tab-cck-logging">
    {{ forms.lightswitchField({
        label:        "Log Consent Events"|t('cookie-consent-flow'),
        instructions: "Store a privacy-safe record of each consent action in the database."|t('cookie-consent-flow'),
        id:   'logEnabled',
        name: 'settings[logEnabled]',
        on:   settings.logEnabled,
    }) }}

    {{ forms.textField({
        label:        "Log Retention (days)"|t('cookie-consent-flow'),
        instructions: "How long to keep consent records. Set to 0 to keep indefinitely."|t('cookie-consent-flow'),
        id:    'logRetentionDays',
        name:  'settings[logRetentionDays]',
        value: settings.logRetentionDays,
        type:  'number',
        min:    0,
    }) }}

</div>{# /tab-logging #}

{# ── Integrations: Google Consent Mode v2 ──────────────────────────────── #}
<div id="cck-integrations" class="hidden" role="tabpanel" aria-labelledby="tab-cck-integrations">

    <div class="cck-page-intro">
        <p>{{ "Google Consent Mode tells Google's own tags what they may store. It is not a replacement for blocking — tag this site's Google scripts with data-cck-category as well."|t('cookie-consent-flow') }}</p>
    </div>

    {{ forms.lightswitchField({
        label:        "Enable Google Consent Mode v2"|t('cookie-consent-flow'),
        instructions: "Send consent signals to Google tags. Map each category to its signals on the Cookie Categories tab."|t('cookie-consent-flow'),
        id:   'consentModeEnabled',
        name: 'settings[consentModeEnabled]',
        on:   settings.consentModeEnabled,
    }) }}

    {{ forms.selectField({
        label:        "Implementation"|t('cookie-consent-flow'),
        instructions: "Advanced: Google tags load immediately with storage denied, and receive an update once the visitor decides. Basic: no Google tag loads until its category is accepted — tag them with data-cck-category."|t('cookie-consent-flow'),
        id:      'consentModeType',
        name:    'settings[consentModeType]',
        value:   settings.consentModeType,
        options: [
            { value: 'advanced', label: "Advanced"|t('cookie-consent-flow') },
            { value: 'basic',    label: "Basic"|t('cookie-consent-flow') },
        ],
    }) }}

    {{ forms.lightswitchField({
        label:        "Auto-inject into <head>"|t('cookie-consent-flow'),
        instructions: "Place the snippet as the first thing in <head> automatically. Turn off only if you need to position it yourself with craft.cookieConsent.consentModeScript()."|t('cookie-consent-flow'),
        id:   'consentModeAutoInject',
        name: 'settings[consentModeAutoInject]',
        on:   settings.consentModeAutoInject,
    }) }}

    {{ forms.textField({
        label:        "wait_for_update (ms)"|t('cookie-consent-flow'),
        instructions: "How long Google waits for a consent update before acting on the default state. 500 suits most sites; 0 disables the wait."|t('cookie-consent-flow'),
        id:    'consentModeWaitForUpdate',
        name:  'settings[consentModeWaitForUpdate]',
        value: settings.consentModeWaitForUpdate,
        type:  'number',
        min:    0,
        max:    10000,
    }) }}

    {{ forms.lightswitchField({
        label:        "URL passthrough"|t('cookie-consent-flow'),
        instructions: "Pass ad click information through URLs when ad storage is denied, so conversions can still be measured without cookies."|t('cookie-consent-flow'),
        id:   'consentModeUrlPassthrough',
        name: 'settings[consentModeUrlPassthrough]',
        on:   settings.consentModeUrlPassthrough,
    }) }}

    {{ forms.lightswitchField({
        label:        "Ads data redaction"|t('cookie-consent-flow'),
        instructions: "Redact ad click identifiers in network requests while ad storage is denied."|t('cookie-consent-flow'),
        id:   'consentModeAdsDataRedaction',
        name: 'settings[consentModeAdsDataRedaction]',
        on:   settings.consentModeAdsDataRedaction,
    }) }}

</div>{# /tab-integrations #}

{# ── Privacy Signals ───────────────────────────────────────────────────── #}
<div id="cck-privacy-signals" class="hidden" role="tabpanel" aria-labelledby="tab-cck-privacy-signals">

    <div class="cck-page-intro">
        <p>{{ "Some browsers send a machine-readable privacy preference. When one is honoured, the visitor is treated as having rejected every optional category and is not shown the banner."|t('cookie-consent-flow') }}</p>
    </div>

    {{ forms.lightswitchField({
        label:        "Honour Global Privacy Control (GPC)"|t('cookie-consent-flow'),
        instructions: "GPC is an explicit, deliberate signal and is recognised by several US state privacy laws. Recommended."|t('cookie-consent-flow'),
        id:   'respectGpc',
        name: 'settings[respectGpc]',
        on:   settings.respectGpc,
    }) }}

    {{ forms.lightswitchField({
        label:        "Honour Do Not Track (DNT)"|t('cookie-consent-flow'),
        instructions: "DNT carries no general legal force and some browsers enable it by default, so it is a weaker signal of intent than GPC. Off unless you have decided to treat it as a rejection."|t('cookie-consent-flow'),
        id:   'respectDnt',
        name: 'settings[respectDnt]',
        on:   settings.respectDnt,
    }) }}

</div>{# /tab-privacy-signals #}

{# ── Advanced ──────────────────────────────────────────────────────────── #}
<div id="cck-advanced" class="hidden" role="tabpanel" aria-labelledby="tab-cck-advanced">

    <div class="cck-page-intro">
        <p>{{ "Additional plugin-level options."|t('cookie-consent-flow') }}</p>
    </div>

    {{ forms.textField({
        label:        "Consent Expiry (days)"|t('cookie-consent-flow'),
        instructions: "How long a visitor's consent stays valid before the banner is shown again. Set to 0 to never expire. Guidance (ICO/CNIL) recommends re-asking within 6–12 months."|t('cookie-consent-flow'),
        id:    'consentExpiryDays',
        name:  'settings[consentExpiryDays]',
        value: settings.consentExpiryDays,
        type:  'number',
        min:    0,
    }) }}

    {{ forms.textField({
        label:        "Policy Version"|t('cookie-consent-flow'),
        instructions: "Every stored consent carries the policy version in effect when it was given. Change this and each visitor is asked again."|t('cookie-consent-flow'),
        id:    'policyVersion',
        name:  'settings[policyVersion]',
        value: settings.policyVersion,
    }) }}

    <hr>

    <div class="field">
        <div class="heading">
            <label>{{ "Invalidate Existing Consent"|t('cookie-consent-flow') }}</label>
        </div>
        <div class="instructions">
            <p>
                {{ "Sets a new policy version, so every visitor is asked to consent again on their next visit. Do this after a material change — a new category, a new tracker, a changed purpose."|t('cookie-consent-flow') }}
            </p>
            <p class="light">
                {{ "Existing consent records are not deleted: they remain accurate evidence of what each visitor agreed to under the previous policy."|t('cookie-consent-flow') }}
            </p>
        </div>
        <div class="input">
            {# Posted by cookie-consent.js rather than being a submit button:
               this page is one big form targeting settings/save, and a second
               submit control inside it would either fight over the action
               parameter or require nesting a form, which is invalid markup. #}
            <button
                type="button"
                class="btn caution"
                id="cck-invalidate-consent"
                data-action="cookie-consent-flow/settings/invalidate-consent"
                data-confirm="{{ 'Ask every visitor for consent again? This cannot be undone, and existing consent records are kept.'|t('cookie-consent-flow') }}"
            >{{ "Invalidate Existing Consent"|t('cookie-consent-flow') }}</button>
        </div>
    </div>

</div>{# /tab-advanced #}

</div>{# /#cck-settings #}

{% if craft.app.sites.allSites|length > 1 %}
    <hr>
    <p>
        <a href="{{ cpUrl('cookie-consent-flow/settings/multi-site-override') }}">
            {{ "Manage Multisite →"|t('cookie-consent-flow') }}
        </a>
    </p>
{% endif %}
{% endblock %}
