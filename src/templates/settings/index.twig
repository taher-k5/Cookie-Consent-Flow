{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Cookie Consent Kit Settings"|t('cookie-consent-kit') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'settings' %}
{% set tabs = {
    categories: { label: "Cookie Categories"|t('cookie-consent-kit'), url: '#tab-categories' },
    logging:    { label: "Consent Logging"|t('cookie-consent-kit'),   url: '#tab-logging' },
    advanced:   { label: "Advanced"|t('cookie-consent-kit'),          url: '#tab-advanced' },
} %}

{% block actionButton %}
    <div class="btngroup">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
<input type="hidden" name="action" value="cookie-consent-kit/settings/save">
{{ redirectInput('cookie-consent-kit/settings') }}
{{ csrfInput() }}

<div id="cck-settings">

{# ── Categories ────────────────────────────────────────────────────────── #}
<div id="tab-categories">
    <p class="light">{{ "Configure the cookie categories visitors can toggle in the preferences panel."|t('cookie-consent-kit') }}</p>

    <div id="cck-categories-list">
        {% for i, category in settings.categories %}
            {% include 'cookie-consent-kit/settings/_category-row' with {
                category: category,
                index:    i,
            } %}
        {% endfor %}
    </div>

    <button type="button" id="cck-add-category" class="btn add icon">
        {{ "Add Category"|t('cookie-consent-kit') }}
    </button>

    <template id="cck-category-template">
        {% include 'cookie-consent-kit/settings/_category-row' with {
            category: { key: '', label: '', description: '', default: false, locked: false },
            index:    '__INDEX__',
        } %}
    </template>
</div>{# /tab-categories #}

{# ── Consent Logging ───────────────────────────────────────────────────── #}
<div id="tab-logging" class="hidden">

    {{ forms.lightswitchField({
        label:        "Log Consent Events"|t('cookie-consent-kit'),
        instructions: "Store a privacy-safe record of each consent action in the database."|t('cookie-consent-kit'),
        id:   'logEnabled',
        name: 'settings[logEnabled]',
        on:   settings.logEnabled,
    }) }}

    {{ forms.textField({
        label:        "Log Retention (days)"|t('cookie-consent-kit'),
        instructions: "How long to keep consent records. Set to 0 to keep indefinitely."|t('cookie-consent-kit'),
        id:    'logRetentionDays',
        name:  'settings[logRetentionDays]',
        value: settings.logRetentionDays,
        type:  'number',
        min:    0,
    }) }}

</div>{# /tab-logging #}

{# ── Advanced ──────────────────────────────────────────────────────────── #}
<div id="tab-advanced" class="hidden">

    <p class="light">{{ "Additional plugin-level options."|t('cookie-consent-kit') }}</p>

    {# Placeholder for future advanced options (cache TTL, custom CSS, etc.) #}
    <p class="light">{{ "More advanced options will appear here in future releases."|t('cookie-consent-kit') }}</p>

</div>{# /tab-advanced #}

</div>{# /#cck-settings #}
{% endblock %}
