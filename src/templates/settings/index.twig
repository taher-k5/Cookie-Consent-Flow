{% extends "_layouts/cp" %}
{% import "_includes/forms" as forms %}

{% set title = "Cookie Consent Flow Settings"|t('cookie-consent-flow') %}
{% set fullPageForm = true %}
{% set selectedSubnavItem = 'settings' %}
{% set tabs = {
    'cck-categories': {
        label: "Cookie Categories"|t('cookie-consent-flow'),
        url: '#cck-categories',
    },
    'cck-logging': {
        label: "Consent Logging"|t('cookie-consent-flow'),
        url: '#cck-logging',
    },
    'cck-advanced': {
        label: "Advanced"|t('cookie-consent-flow'),
        url: '#cck-advanced',
    },
} %}
{% block actionButton %}
    <div class="btngroup">
        <input type="submit" class="btn submit" value="{{ 'Save'|t('app') }}">
    </div>
{% endblock %}

{% block content %}
<input type="hidden" name="action" value="cookie-consent-flow/settings/save">
{{ redirectInput('cookie-consent-flow/settings') }}
{{ csrfInput() }}

<div id="cck-settings">

{# ── Categories ────────────────────────────────────────────────────────── #}
<div id="cck-categories" role="tabpanel" aria-labelledby="tab-cck-categories">
    <p class="light">{{ "Configure the cookie categories visitors can toggle in the preferences panel."|t('cookie-consent-flow') }}</p>

    <div class="cck-categories-group">
        <div id="cck-categories-list" class="cck-categories-list">
            {% for i, category in settings.categories %}
                {% include 'cookie-consent-flow/settings/_category-row' with {
                    category: category,
                    index:    i,
                } %}
            {% endfor %}
        </div>

        <button type="button" id="cck-add-category" class="btn add icon cck-add-category">
            {{ "Add Category"|t('cookie-consent-flow') }}
        </button>

        <template id="cck-category-template" class="cck-category-template">
            {% include 'cookie-consent-flow/settings/_category-row' with {
                category: { key: '', label: '', description: '', default: false, locked: false },
                index:    '__INDEX__',
            } %}
        </template>
    </div>
</div>{# /tab-categories #}

{# ── Consent Logging ───────────────────────────────────────────────────── #}
<div id="cck-logging" class="hidden" role="tabpanel" aria-labelledby="tab-cck-logging">
    {{ forms.lightswitchField({
        label:        "Log Consent Events"|t('cookie-consent-flow'),
        instructions: "Store a privacy-safe record of each consent action in the database."|t('cookie-consent-flow'),
        id:   'logEnabled',
        name: 'settings[logEnabled]',
        on:   settings.logEnabled,
    }) }}

    {{ forms.textField({
        label:        "Log Retention (days)"|t('cookie-consent-flow'),
        instructions: "How long to keep consent records. Set to 0 to keep indefinitely."|t('cookie-consent-flow'),
        id:    'logRetentionDays',
        name:  'settings[logRetentionDays]',
        value: settings.logRetentionDays,
        type:  'number',
        min:    0,
    }) }}

</div>{# /tab-logging #}

{# ── Advanced ──────────────────────────────────────────────────────────── #}
<div id="cck-advanced" class="hidden" role="tabpanel" aria-labelledby="tab-cck-advanced">

    <p class="light">{{ "Additional plugin-level options."|t('cookie-consent-flow') }}</p>

    {{ forms.textField({
        label:        "Consent Expiry (days)"|t('cookie-consent-flow'),
        instructions: "How long a visitor's consent stays valid before the banner is shown again. Set to 0 to never expire. Guidance (ICO/CNIL) recommends re-asking within 6–12 months."|t('cookie-consent-flow'),
        id:    'consentExpiryDays',
        name:  'settings[consentExpiryDays]',
        value: settings.consentExpiryDays,
        type:  'number',
        min:    0,
    }) }}

    {{ forms.textField({
        label:        "Policy Version"|t('cookie-consent-flow'),
        instructions: "Change this any time you materially change the cookie policy or categories — every visitor's existing consent is invalidated and they're asked to consent again."|t('cookie-consent-flow'),
        id:    'policyVersion',
        name:  'settings[policyVersion]',
        value: settings.policyVersion,
    }) }}

</div>{# /tab-advanced #}

</div>{# /#cck-settings #}

{% if craft.app.sites.allSites|length > 1 %}
    <hr>
    <p>
        <a href="{{ cpUrl('cookie-consent-flow/settings/multi-site-override') }}">
            {{ "Manage Multisite →"|t('cookie-consent-flow') }}
        </a>
    </p>
{% endif %}
{% endblock %}
