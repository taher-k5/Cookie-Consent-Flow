{# Partial: a single documented cookie row — used on the standalone (global)
   Cookies page and, with a per-site namePrefix, on the Multisite page. #}
{% import "_includes/forms" as forms %}
{% set namePrefix = namePrefix ?? 'cookies' %}

{% set categoryOptions = [] %}
{% set categoryKeys = [] %}
{% for category in categories %}
    {% set categoryOptions = categoryOptions|merge([{ value: category.key, label: category.label }]) %}
    {% set categoryKeys = categoryKeys|merge([category.key]) %}
{% endfor %}

{# A cookie can outlive the category it was filed under — the category was
   renamed or deleted, and nothing repoints a disclosure automatically, because
   only a human knows which category the cookie now belongs in.

   The orphaned key is added to this row's options rather than left out of
   them. A <select> whose stored value matches no option shows the first option
   instead, so saving the page would silently refile every orphaned cookie
   under whatever category happens to sort first — losing the admin's original
   classification without telling anyone. Keeping the value selectable means
   saving preserves it, and the warning below makes the reassignment a
   deliberate act. #}
{% set isOrphaned = cookie.categoryKey and cookie.categoryKey not in categoryKeys %}
{% if isOrphaned %}
    {% set categoryOptions = categoryOptions|merge([{
        value: cookie.categoryKey,
        label: "{key} (category no longer exists)"|t('cookie-consent-flow', { key: cookie.categoryKey }),
    }]) %}
{% endif %}

<div class="cck-cookie-row{% if isOrphaned %} cck-cookie-row--orphaned{% endif %}" data-index="{{ index }}">
    {# Header strip: the row's own label plus its delete control, so removing
       a cookie is where you expect it rather than below five fields. The
       button keeps its class and stays inside the row, which is all the
       row-scoped JS looks for. #}
    <div class="cck-cookie-row__header">
        <span class="cck-cookie-row__label">{{ "Cookie"|t('cookie-consent-flow') }}</span>

        <button
            type="button"
            class="btn small delete icon cck-remove-cookie"
            title="{{ 'Remove cookie'|t('cookie-consent-flow') }}"
            aria-label="{{ 'Remove cookie'|t('cookie-consent-flow') }}"
        >{{ "Remove"|t('cookie-consent-flow') }}</button>
    </div>

    {% if isOrphaned %}
        <p class="cck-cookie-row__warning" role="note">
            {{ "This cookie's category no longer exists, so visitors are not shown it. Pick a current category, or remove the row."|t('cookie-consent-flow') }}
        </p>
    {% endif %}

    <div class="cck-cookie-row__fields">

        {{ forms.selectField({
            label:   "Category"|t('cookie-consent-flow'),
            name:    namePrefix ~ '[' ~ index ~ '][categoryKey]',
            options: categoryOptions,
            value:   cookie.categoryKey,
        }) }}

        {{ forms.textField({
            label:        "Cookie Name"|t('cookie-consent-flow'),
            instructions: "The exact cookie name, or a pattern like _ga_* for a family of cookies."|t('cookie-consent-flow'),
            name:         namePrefix ~ '[' ~ index ~ '][name]',
            value:        cookie.name,
            required:     true,
            class:        'code',
        }) }}

        {{ forms.textField({
            label: "Provider"|t('cookie-consent-flow'),
            instructions: "Who sets this cookie, e.g. Google Analytics."|t('cookie-consent-flow'),
            name:  namePrefix ~ '[' ~ index ~ '][provider]',
            value: cookie.provider,
        }) }}

        {{ forms.textField({
            label: "Duration"|t('cookie-consent-flow'),
            instructions: "e.g. 2 years, Session."|t('cookie-consent-flow'),
            name:  namePrefix ~ '[' ~ index ~ '][duration]',
            value: cookie.duration,
        }) }}

        {{ forms.textareaField({
            label: "Purpose"|t('cookie-consent-flow'),
            instructions: "What this cookie is used for — shown to visitors in the preferences panel."|t('cookie-consent-flow'),
            name:  namePrefix ~ '[' ~ index ~ '][purpose]',
            value: cookie.purpose,
            rows:  2,
        }) }}
    </div>
</div>
