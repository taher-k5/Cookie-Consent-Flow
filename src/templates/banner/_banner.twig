{#
  Cookie Consent Flow — Banner + Preferences Modal
  Rendered by CookieConsentVariable::renderBanner().
  The banner is hidden by default; JS reveals it when no consent is stored.
#}

{# ----- Dynamic CSS custom properties ----- #}
<style>{{ settings.cssVars|raw }}</style>

{# ----- Consent Banner ----- #}
{% set layoutClass = 'cck-layout--' ~ settings.bannerLayout %}
{% set cornerClass = (settings.bannerLayout == 'corner-popup') ? ' cck-corner--' ~ settings.cornerPosition : '' %}

{# The center-popup layout dims the page behind the banner, which makes it a
   modal in appearance. It is therefore marked up as one below, and the runtime
   moves and traps focus to match.

   Except in the control panel's live preview (`isPreview`), which renders this
   same template as an illustration inside a page the admin is still using. A
   preview that claimed `aria-modal` would tell assistive technology that the
   rest of the Dashboard is inert, so the preview stays a plain region — it has
   no runtime, no focus management and nothing to trap focus for.

   The overlay below is presentational only; the dialog carries the semantics. #}
{% set isPreview = isPreview ?? false %}
{% set isModalLayout = settings.bannerLayout == 'center-popup' and not isPreview %}

{% if settings.bannerLayout == 'center-popup' %}
  <div
    class="cck-banner-overlay"
    id="cck-banner-overlay"
    aria-hidden="true"
    hidden
  ></div>
{% endif %}
{#
  role depends on the layout, because the layouts are genuinely different
  things. A bar leaves the page fully usable, so it is a labelled region;
  announcing it as a modal dialog would misdescribe it. The center popup dims
  the page behind it, so it is a dialog and says so — page content behind it is
  removed from the accessibility tree by aria-modal, and cookie-banner.js moves
  focus in and traps it there. Escape still records nothing in either case:
  dismissal without a choice would have to be stored as one.

  No aria-live: the banner is present from page load and revealed by script,
  and a live region would re-announce it over whatever the visitor was already
  reading. The labelled region is discoverable by landmark navigation instead.
#}
<div
  id="cck-banner"
  class="cck-banner {{ layoutClass }}{{ cornerClass }}"
  role="{{ isModalLayout ? 'dialog' : 'region' }}"
  {% if isModalLayout %}aria-modal="true"{% endif %}
  aria-labelledby="cck-banner-heading"
  hidden
>
  <div class="cck-banner__inner">

    {# Content #}
    <div class="cck-banner__content">
      {% if settings.logoUrl %}
        <img src="{{ settings.logoUrl }}" alt="" class="cck-banner__logo">
      {% endif %}

      {# Always rendered, hidden visually when empty, because it is what
         labels the region above — an unlabelled landmark is worse than a
         redundant one. #}
      <h2 id="cck-banner-heading"
          class="cck-banner__heading{% if not settings.bannerHeading %} cck-visually-hidden{% endif %}">
        {{ settings.bannerHeading ?: "Cookie consent"|t('cookie-consent-flow') }}
      </h2>

      {% if settings.bannerDescription %}
        <p class="cck-banner__description">{{ settings.safeDescription|raw }}</p>
      {% endif %}

      {% if settings.safePrivacyPolicyUrl %}
        <a
          href="{{ settings.safePrivacyPolicyUrl|e('html_attr') }}"
          class="cck-banner__link"
          target="_blank"
          rel="noopener noreferrer"
        >{{ settings.privacyPolicyLinkText }}</a>
      {% endif %}
    </div>

    {# Action buttons #}
    <div class="cck-banner__actions" role="group" aria-label="{{ 'Cookie consent options'|t('cookie-consent-flow') }}">
      {# No aria-label on these: each button's visible text already names it,
         and an aria-label duplicating that text overrides what a voice-control
         user would say, for no benefit. #}
      <button type="button" class="cck-btn cck-btn--accept" data-cck-action="accept-all">
        {{- settings.acceptButtonText -}}
      </button>

      <button type="button" class="cck-btn cck-btn--reject" data-cck-action="reject-all">
        {{- settings.rejectButtonText -}}
      </button>

      <button
        type="button"
        class="cck-btn cck-btn--customize"
        data-cck-action="open-preferences"
        aria-haspopup="dialog"
        aria-controls="cck-preferences"
      >{{ settings.customizeButtonText }}</button>
    </div>

  </div>{# /.cck-banner__inner #}
</div>{# /#cck-banner #}


{# ----- Preferences Modal ----- #}
<div
  id="cck-preferences"
  class="cck-preferences"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cck-pref-title"
  aria-hidden="true"
  hidden
>
  {# Overlay backdrop #}
  <div
    class="cck-preferences__overlay"
    data-cck-action="close-preferences"
    aria-hidden="true"
    tabindex="-1"
  ></div>

  {# Panel #}
  <div class="cck-preferences__panel">

    {# Header #}
    <div class="cck-preferences__header">
      {% if settings.logoUrl %}
        <img src="{{ settings.logoUrl }}" alt="" class="cck-preferences__logo">
      {% endif %}
      <h2 id="cck-pref-title" class="cck-preferences__title">
        {{ settings.customizeButtonText }}
      </h2>
      <button
        type="button"
        class="cck-preferences__close"
        data-cck-action="close-preferences"
        aria-label="{{ settings.closeButtonText|e('html_attr') }}"
        title="{{ settings.closeButtonText }}"
      >
        {# Close icon (SVG inline for zero-dependency) #}
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
          <path d="M15 5L5 15M5 5l10 10" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    {# Description #}
    {% if settings.bannerDescription %}
      <p class="cck-preferences__description">{{ settings.safeDescription|raw }}</p>
    {% endif %}

    {# Category toggles #}
    {% set cookiesByCategory = craft.cookieConsent.cookiesByCategory %}
    <div class="cck-categories" role="list">
      {% for category in settings.categories %}
        {% set categoryCookies = cookiesByCategory[category.key] ?? [] %}
        <div
          class="cck-category{% if category.locked %} cck-category--locked{% endif %}"
          role="listitem"
        >
          <div class="cck-category__header">
            <div class="cck-category__info">
              <h3 class="cck-category__name">{{ category.label }}</h3>
              {% if category.description %}
                <p class="cck-category__desc" id="cck-cat-desc-{{ category.key|e('html_attr') }}">
                  {{- category.description -}}
                </p>
              {% endif %}
            </div>

            {# The label wraps the input and carries the accessible name, so
               the control announces as e.g. "Analytics, checkbox". A locked
               category uses disabled (not just aria-disabled) so it is genuinely
               not operable, and states why in text rather than only visually. #}
            <label class="cck-toggle{% if category.locked %} cck-toggle--disabled{% endif %}">
              <input
                type="checkbox"
                data-category="{{ category.key|e('html_attr') }}"
                {% if category.locked or category.default %}checked{% endif %}
                {% if category.locked %}disabled{% endif %}
                {% if category.description %}aria-describedby="cck-cat-desc-{{ category.key|e('html_attr') }}"{% endif %}
              >
              <span class="cck-toggle__track" aria-hidden="true"></span>
              <span class="cck-visually-hidden">
                {{- category.label }}{% if category.locked %} — {{ "always active"|t('cookie-consent-flow') }}{% endif -%}
              </span>
            </label>
          </div>

          {# Per-cookie disclosure — WHAT is actually used, not just the
             category-level description above. Documented on the Cookies CP
             page; a category with nothing documented yet shows nothing here. #}
          {% if categoryCookies|length %}
            <details class="cck-category__cookies">
              <summary class="cck-category__cookies-summary">
                {{ "Cookies used ({count})"|t('cookie-consent-flow', { count: categoryCookies|length }) }}
              </summary>
              <ul class="cck-cookie-list">
                {% for cookie in categoryCookies %}
                  <li class="cck-cookie-list__item">
                    <span class="cck-cookie-list__name">{{ cookie.name }}</span>
                    {% if cookie.provider or cookie.duration %}
                      <span class="cck-cookie-list__meta">
                        {%- if cookie.provider -%}{{ cookie.provider }}{%- endif -%}
                        {%- if cookie.provider and cookie.duration %} · {% endif -%}
                        {%- if cookie.duration -%}{{ cookie.duration }}{%- endif -%}
                      </span>
                    {% endif %}
                    {% if cookie.purpose %}
                      <p class="cck-cookie-list__purpose">{{ cookie.purpose }}</p>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </details>
          {% endif %}
        </div>
      {% endfor %}
    </div>{# /.cck-categories #}

    {# Footer #}
    <div class="cck-preferences__footer">
      <button
        type="button"
        class="cck-btn cck-btn--reject"
        data-cck-action="reject-all"
      >{{ settings.rejectButtonText }}</button>

      <button type="button" class="cck-btn cck-btn--save" data-cck-action="save-preferences">
        {{- settings.savePreferencesText -}}
      </button>

      <button type="button" class="cck-btn cck-btn--accept" data-cck-action="accept-all">
        {{- settings.acceptButtonText -}}
      </button>
    </div>

  </div>{# /.cck-preferences__panel #}
</div>{# /#cck-preferences #}
